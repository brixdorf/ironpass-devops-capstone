terraform {
  required_version = ">= 1.7.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.95"
    }
  }
}

provider "aws" {
  region = var.aws_region

  # every resource that supports tags gets these automatically
  default_tags {
    tags = local.tags
  }
}
