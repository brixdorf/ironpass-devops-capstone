# Copy this file to terraform.tfvars and change the values you need.
# terraform.tfvars is ignored by git. Never put access keys in here.

aws_region         = "ap-south-1"
project            = "ironpass"
environment        = "dev"
cluster_name       = "ironpass-eks"
kubernetes_version = "1.35"

# t3.medium is the usual choice. A free plan account refuses it, so this project
# uses c7i-flex.large (same 2 vCPU and 4 GiB).
node_instance_type = "c7i-flex.large"
node_desired_size  = 2
node_min_size      = 2
node_max_size      = 3

# repository that is allowed to deploy through GitHub OIDC
github_repository = "brixdorf/ironpass-devops-capstone"
github_branch     = "main"

# Subject prefix that GitHub puts in its tokens. Find it with
#   gh api repos/OWNER/NAME/actions/oidc/customization/sub
github_oidc_subject_prefix = "repo:brixdorf@180433577/ironpass-devops-capstone@1421043713"
